{
	"mcpServers": {
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"tools": [
				"*"
			]
		},
		"playwright": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@playwright/mcp@latest"
			],
			"tools": [
				"*"
			]
		},
		"supabase": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@supabase/mcp-server-supabase@latest"],
			"tools": ["*"],
			"env": {
				"SUPABASE_ACCESS_TOKEN": "${SUPABASE_ACCESS_TOKEN}"
			}
		}
	}
}
